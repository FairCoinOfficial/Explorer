FAIRCOIN_RPC_USER=fair
FAIRCOIN_RPC_PASS=change_me
FAIRCOIN_RPC_HOST=127.0.0.1
FAIRCOIN_RPC_PORT=46373
FAIRCOIN_RPC_SCHEME=http

# MongoDB Configuration
# Both Mongoose and the native cache client use the same db name:
# MONGODB_DB_NAME if set, otherwise the path segment of MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017/faircoin-explorer
# MONGODB_DB_NAME=faircoin-explorer

# Vite dev proxy target (optional). Defaults to http://localhost:8080 to match
# the API server PORT below. Set when pointing the SPA at a remote API.
# VITE_API_TARGET=http://localhost:8080

# WebSocket Configuration
WEBSOCKET_ENABLED=true
# Networks the realtime monitor polls (comma-separated: mainnet,testnet).
# Only list networks you actually run a node for.
WEBSOCKET_NETWORKS=mainnet
# Block + mempool poll interval (ms). Default 4000.
BLOCKCHAIN_POLL_INTERVAL=4000
WEBSOCKET_HEARTBEAT_INTERVAL=30000
WEBSOCKET_MAX_CONNECTIONS_PER_IP=5
WEBSOCKET_MAX_PAYLOAD_BYTES=65536

# App Configuration
# Public site URL (MCP links, etc.). Defaults to https://explorer.fairco.in.
# The JSON API allows any browser origin via CORS; this is not an allowlist.
PUBLIC_BASE_URL=https://explorer.fairco.in

# Reverse proxies whose X-Forwarded-* headers are trusted for client IP rate
# limiting. Leave blank if the API can be reached directly; set comma-separated
# IP/CIDR ranges (for example: 127.0.0.1,10.0.0.0/8,::1) only for proxies that
# overwrite or sanitize X-Forwarded-For before forwarding requests.
TRUSTED_PROXY_CIDRS=
HOST=0.0.0.0
PORT=8080

# GitHub API token (optional). Used by GET /api/github to raise the
# unauthenticated rate limit. Generate a fine-grained read-only token; leave
# blank to use anonymous requests (lower rate limit).
GITHUB_TOKEN=

# Background payment notifications (optional, Phase 1 = safe no-op if unset).
# The service watches wallets' registered account xpubs and sends SILENT pushes
# (only { txid, event, subscriptionId } — never amounts or addresses). Leave ALL
# of these blank and the feature is completely inert; set a transport's creds to
# enable it. Secrets never belong in the repo — set these in the host env only.
#
# Android (FCM HTTP v1): the Firebase service-account JSON, as a single-line
# string (or the JSON contents). Presence of this alone enables Android pushes.
FCM_SERVICE_ACCOUNT_JSON=
# iOS (APNS token auth): all four are required together to enable iOS pushes.
# APNS_KEY_P8 is the AuthKey .p8 contents (literal \n escapes are accepted).
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# APNS host: "sandbox" for dev/TestFlight-debug builds; anything else = production.
APNS_ENV=production

# Logging
# error | warn | info (default) | debug.
# At info, per-connection / per-broadcast / per-poll chatter is suppressed.
LOG_LEVEL=info
